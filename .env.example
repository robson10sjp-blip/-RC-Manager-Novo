# Variáveis da Secretária RC com IA. Configure os valores no painel do Netlify
# (Site configuration > Environment variables) ou em .env.local na sua máquina.
# Nunca use o prefixo VITE_ nestas variáveis e nunca versione valores reais.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
FIREBASE_PROJECT_ID=
AI_RATE_PER_MINUTE=5
AI_DAILY_LIMIT=60
AI_TIMEOUT_MS=22000

# Mantenha desativado até a IA ser liberada.
SECRETARY_AI_ENABLED=false
VITE_SECRETARY_AI_ENABLED=false
