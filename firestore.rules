rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function nonNegativeNumber(value) {
      return (value is int || value is float) && value >= 0;
    }

    function nonNegativeInt(value) {
      return value is int && value >= 0;
    }

    // Criação: campo ausente é aceito; se existir, precisa ser número >= 0.
    function optionalNumber(field) {
      return !(field in request.resource.data)
        || nonNegativeNumber(request.resource.data[field]);
    }

    // Edição: campo inalterado (inclusive valores antigos fora do padrão) é aceito;
    // se foi alterado, precisa ser número >= 0.
    function unchangedOrNumber(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null)
        || nonNegativeNumber(request.resource.data.get(field, null));
    }

    function unchangedOrInt(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null)
        || nonNegativeInt(request.resource.data.get(field, null));
    }

    function unchangedOrString(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null)
        || request.resource.data.get(field, null) is string;
    }

    function optionalPaymentBalances() {
      return optionalNumber('value')
        && optionalNumber('previousBalance')
        && optionalNumber('remainingBalance')
        && request.resource.data.get('remainingBalance', 0)
          <= request.resource.data.get('previousBalance', 0);
    }

    function hasPurchaseCorrection(uid, payableId) {
      let correctionId = request.resource.data.get('lastCorrectionId', '');
      let correctionPath = /databases/$(database)/documents/users/$(uid)/payables/$(payableId)/corrections/$(correctionId);
      let correction = getAfter(correctionPath).data;
      return correctionId is string
        && correctionId.size() > 0
        && correctionId != resource.data.get('lastCorrectionId', '')
        && !exists(correctionPath)
        && existsAfter(correctionPath)
        && correction.type in ['purchase', 'check']
        && correction.payableId == payableId
        && correction.createdAt == request.time
        && correction.after.totalAmount == request.resource.data.totalAmount
        && correction.after.description == request.resource.data.get('description', null)
        && correction.after.purchaseDate == request.resource.data.get('purchaseDate', null)
        && correction.after.balance == request.resource.data.get('balance', null)
        && correction.after.paymentType == request.resource.data.get('paymentType', null)
        && correction.after.initialPaymentAmount == request.resource.data.get('initialPaymentAmount', null)
        && correction.after.dueDate == request.resource.data.get('dueDate', null)
        && correction.after.status == request.resource.data.get('status', null)
        && correction.after.installments == request.resource.data.installments;
    }

    function hasPaymentCorrection(uid, payableId, paymentId) {
      let correctionId = request.resource.data.get('lastCorrectionId', '');
      let correctionPath = /databases/$(database)/documents/users/$(uid)/payables/$(payableId)/corrections/$(correctionId);
      let correction = getAfter(correctionPath).data;
      return correctionId is string
        && correctionId.size() > 0
        && correctionId != resource.data.get('lastCorrectionId', '')
        && !exists(correctionPath)
        && existsAfter(correctionPath)
        && correction.type == 'payment'
        && correction.payableId == payableId
        && correction.paymentId == paymentId
        && correction.createdAt == request.time
        && correction.after.amount == request.resource.data.amount
        && correction.after.date == request.resource.data.date
        && correction.after.method == request.resource.data.method;
    }

    function validClientClassification(data) {
      return !('classification' in data) || data.classification in [
        'unclassified',
        'excellent',
        'good',
        'regular',
        'poor',
        'prego',
      ];
    }

    function validTripReference(uid, data) {
      return data.tripId is string
        && data.tripId.size() <= 250
        && data.tripName is string
        && data.tripName.size() > 0
        && data.tripName.size() <= 100
        && (data.tripId.matches('^legacy-(number|name)-[a-z0-9-]+$')
          || get(/databases/$(database)/documents/users/$(uid)/trips/$(data.tripId)).data.name == data.tripName);
    }

    function validOptionalSaleTrip(uid) {
      return request.resource.data.get('tripId', '') == ''
        || validTripReference(uid, request.resource.data);
    }

    function validCalendarDate(value) {
      let parts = value.split('-');
      let year = int(parts[0]);
      let month = int(parts[1]);
      let day = int(parts[2]);
      let leap = year % 400 == 0 || (year % 4 == 0 && year % 100 != 0);
      return value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && day <= (month == 2 ? (leap ? 29 : 28) : (month in [4, 6, 9, 11] ? 30 : 31));
    }

    function validActionScope(uid, data) {
      return (data.get('actionDate', '') == '' && validTripReference(uid, data))
        || (data.actionDate is string
          && validCalendarDate(data.actionDate)
          && ((data.get('tripId', '') == '' && data.get('tripName', '') == '')
            || validTripReference(uid, data)));
    }

    function validVisit(uid) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'clientId', 'city', 'cityKey', 'tripId', 'tripName', 'status',
          'history', 'createdAt', 'updatedAt', 'actionDate'
        ])
        && data.clientId is string
        && data.city is string
        && data.cityKey is string
        && data.cityKey.size() > 0
        && data.cityKey.size() <= 100
        && data.city == get(/databases/$(database)/documents/users/$(uid)/clients/$(data.clientId)).data.city
        && validActionScope(uid, data)
        && data.status in ['not_purchased', 'unvisited']
        && data.history is list
        && data.history.size() > 0
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function giftStockChange(uid, gift, returning) {
      let before = get(/databases/$(database)/documents/users/$(uid)/products/$(gift.productId)).data;
      let after = getAfter(/databases/$(database)/documents/users/$(uid)/products/$(gift.productId)).data;
      return nonNegativeInt(before.quantity)
        && nonNegativeInt(after.quantity)
        && after.quantity == before.quantity + (returning ? gift.quantity : -gift.quantity)
        && after.diff(before).affectedKeys().hasOnly(['quantity', 'updatedAt'])
        && after.updatedAt == request.time;
    }

    function giftMovementMatches(uid, giftId, gift, movementId, returning) {
      let movement = getAfter(/databases/$(database)/documents/users/$(uid)/stockMovements/$(movementId)).data;
      let product = get(/databases/$(database)/documents/users/$(uid)/products/$(gift.productId)).data;
      return !exists(/databases/$(database)/documents/users/$(uid)/stockMovements/$(movementId))
        && movement.type == (returning ? 'cancelamento_brinde' : 'brinde')
        && movement.giftId == giftId
        && movement.clientId == gift.clientId
        && movement.productId == gift.productId
        && movement.quantity == gift.quantity
        && movement.unitCost == gift.unitCost
        && movement.totalCost == gift.totalCost
        && movement.get('tripId', '') == gift.get('tripId', '')
        && movement.get('tripCity', '') == gift.get('tripCity', '')
        && movement.previousQuantity == product.quantity
        && movement.newQuantity == product.quantity + (returning ? gift.quantity : -gift.quantity)
        && movement.createdAt == request.time;
    }

    function validGiftCreate(uid, giftId) {
      let gift = request.resource.data;
      let product = get(/databases/$(database)/documents/users/$(uid)/products/$(gift.productId)).data;
      return gift.keys().hasOnly([
          'clientId', 'productId', 'productName', 'quantity', 'giftDate',
          'tripId', 'tripName', 'tripCity', 'cityKey', 'unitCost', 'totalCost',
          'status', 'stockMovementId', 'createdAt', 'actionDate'
        ])
        && gift.clientId is string && gift.productId is string
        && gift.productName == product.get('name', '')
        && gift.tripCity == get(/databases/$(database)/documents/users/$(uid)/clients/$(gift.clientId)).data.city
        && gift.cityKey is string && gift.cityKey.size() > 0
        && validActionScope(uid, gift)
        && nonNegativeInt(gift.quantity) && gift.quantity > 0
        && nonNegativeNumber(gift.unitCost)
        && gift.unitCost == float(product.costPrice)
        && nonNegativeNumber(gift.totalCost)
        // Mesmo arredondamento de calculateGiftCost, incluindo Number.EPSILON.
        && math.abs(gift.totalCost - math.round(
          (gift.unitCost * gift.quantity + 0.0000000000000002220446049250313) * 100
        ) / 100.0) < 0.000001
        && gift.status == 'active'
        && gift.giftDate == request.time && gift.createdAt == request.time
        && gift.stockMovementId == 'gift-' + giftId
        && giftStockChange(uid, gift, false)
        && giftMovementMatches(uid, giftId, gift, gift.stockMovementId, false);
    }

    function validGiftCancel(uid, giftId) {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'active' && after.status == 'cancelled'
        && after.diff(before).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancelStockMovementId'])
        && nonNegativeInt(before.quantity) && before.quantity > 0
        && nonNegativeNumber(before.unitCost) && nonNegativeNumber(before.totalCost)
        && after.cancelledAt == request.time
        && after.cancelStockMovementId == 'gift-cancel-' + giftId
        && giftStockChange(uid, before, true)
        && giftMovementMatches(uid, giftId, before, after.cancelStockMovementId, true);
    }

    function validGiftMovement(uid, movementId) {
      let data = request.resource.data;
      let gift = getAfter(/databases/$(database)/documents/users/$(uid)/clientGifts/$(data.giftId)).data;
      let giftPath = /databases/$(database)/documents/users/$(uid)/clientGifts/$(data.giftId);
      let returning = data.type == 'cancelamento_brinde';
      return (returning
          ? get(giftPath).data.status == 'active' && gift.status == 'cancelled'
            && gift.cancelStockMovementId == movementId
          : !exists(giftPath) && gift.status == 'active' && gift.stockMovementId == movementId)
        && giftStockChange(uid, gift, returning)
        && giftMovementMatches(uid, data.giftId, gift, movementId, returning);
    }

    match /users/{uid} {
      allow read, write: if false;

      match /clients/{clientId} {
        allow read: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.name is string
          && request.resource.data.city is string
          && optionalNumber('totalDebt')
          && validClientClassification(request.resource.data);
        allow update: if owner(uid)
          && unchangedOrString('name')
          && unchangedOrString('city')
          && unchangedOrNumber('totalDebt')
          && unchangedOrNumber('totalReceived')
          && validClientClassification(request.resource.data);
        allow delete: if owner(uid);
      }

      match /clients/{clientId}/payments/{paymentId} {
        allow read: if owner(uid);
        allow create: if owner(uid) && optionalPaymentBalances();
        allow update, delete: if false;
      }

      match /products/{productId} {
        allow read: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.name is string
          && optionalNumber('quantity')
          && optionalNumber('costPrice')
          && optionalNumber('salePrice');
        allow update: if owner(uid)
          && unchangedOrString('name')
          && unchangedOrInt('quantity')
          && unchangedOrNumber('costPrice')
          && unchangedOrNumber('salePrice');
        allow delete: if owner(uid);
      }

      match /sales/{saleId} {
        allow read: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.clientId is string
          && request.resource.data.items is list
          && nonNegativeNumber(request.resource.data.total)
          && nonNegativeNumber(request.resource.data.amountPaid)
          && nonNegativeNumber(request.resource.data.pendingAmount)
          && request.resource.data.pendingAmount <= request.resource.data.total
          && validOptionalSaleTrip(uid);
        allow update: if owner(uid)
          && request.resource.data.get('clientId', null) == resource.data.get('clientId', null)
          && request.resource.data.get('items', []) is list
          && unchangedOrNumber('total')
          && unchangedOrNumber('amountPaid')
          && unchangedOrNumber('pendingAmount')
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['tripId', 'tripName'])
            || validOptionalSaleTrip(uid));
        // Compras com recebimento nunca são excluídas, preservando o histórico.
        allow delete: if owner(uid)
          && resource.data.get('amountPaid', 0) == 0;
      }

      match /sales/{saleId}/payments/{paymentId} {
        allow read: if owner(uid);
        allow create: if owner(uid) && optionalPaymentBalances();
        allow update, delete: if false;
      }

      match /expenses/{expenseId} {
        allow read, create, update, delete: if owner(uid);
      }

      match /suppliers/{supplierId} {
        allow read, create, update, delete: if owner(uid);
      }

      match /payables/{payableId} {
        allow read: if owner(uid);
        allow create: if owner(uid)
          && optionalNumber('totalAmount')
          && optionalNumber('paidAmount')
          && optionalNumber('balance');
        allow update: if owner(uid)
          && unchangedOrNumber('totalAmount')
          && unchangedOrNumber('paidAmount')
          && unchangedOrNumber('balance')
          && unchangedOrString('description')
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'description', 'totalAmount', 'purchaseDate', 'dueDate',
            'paymentType', 'initialPaymentAmount', 'lastCorrectionId'
          ])
            || hasPurchaseCorrection(uid, payableId));
        allow delete: if owner(uid);
      }

      match /payables/{payableId}/payments/{paymentId} {
        allow read: if owner(uid);
        allow create: if owner(uid) && optionalNumber('amount');
        allow update: if owner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'amount', 'date', 'method', 'identification', 'bankAccount',
            'bankName', 'issueDate', 'expectedCompensationDate', 'allocations',
            'lastCorrectionId', 'updatedAt'
          ])
          && unchangedOrNumber('amount')
          && request.resource.data.amount > 0
          && hasPaymentCorrection(uid, payableId, paymentId);
        allow delete: if false;
      }

      match /payables/{payableId}/corrections/{correctionId} {
        allow read: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.payableId == payableId
          && request.resource.data.type in ['purchase', 'payment', 'check']
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /stockMovements/{movementId} {
        allow read: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.productId is string
          && request.resource.data.type is string
          && nonNegativeNumber(request.resource.data.quantity)
          && nonNegativeNumber(request.resource.data.previousQuantity)
          && nonNegativeNumber(request.resource.data.newQuantity)
          && (request.resource.data.type in ['brinde', 'cancelamento_brinde']
            ? validGiftMovement(uid, movementId)
            : !('giftId' in request.resource.data)
              && !movementId.matches('^gift-.*$'));
        allow update, delete: if false;
      }

      match /trips/{tripId} {
        allow read: if owner(uid);
        allow create: if owner(uid)
          && tripId.matches('^trip-[a-f0-9-]{36}$')
          && request.resource.data.keys().hasOnly(['name', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      // A classificacao Prego usa clients; a colecao legada permanece somente leitura.
      match /pregoClients/{clientId} {
        allow read: if owner(uid);
        allow write: if false;
      }

      match /clientVisits/{visitId} {
        allow read: if owner(uid);
        allow create: if owner(uid) && validVisit(uid)
          && request.resource.data.createdAt == request.time;
        allow update: if owner(uid) && validVisit(uid)
          && request.resource.data.clientId == resource.data.clientId
          && request.resource.data.cityKey == resource.data.cityKey
          && request.resource.data.tripId == resource.data.tripId
          && (resource.data.tripId != ''
            || request.resource.data.get('actionDate', '') == resource.data.get('actionDate', ''))
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }

      match /clientGifts/{giftId} {
        allow read: if owner(uid);
        allow create: if owner(uid) && validGiftCreate(uid, giftId);
        allow update: if owner(uid) && validGiftCancel(uid, giftId);
        allow delete: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
