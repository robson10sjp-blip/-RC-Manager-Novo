rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function nonNegativeNumber(value) {
      return (value is int || value is float) && value >= 0;
    }

    function nonNegativeInt(value) {
      return value is int && value >= 0;
    }

    // Criação: campo ausente é aceito; se existir, precisa ser número >= 0.
    function optionalNumber(field) {
      return !(field in request.resource.data)
        || nonNegativeNumber(request.resource.data[field]);
    }

    // Edição: campo inalterado (inclusive valores antigos fora do padrão) é aceito;
    // se foi alterado, precisa ser número >= 0.
    function unchangedOrNumber(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null)
        || nonNegativeNumber(request.resource.data.get(field, null));
    }

    function unchangedOrInt(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null)
        || nonNegativeInt(request.resource.data.get(field, null));
    }

    function unchangedOrString(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null)
        || request.resource.data.get(field, null) is string;
    }

    function optionalPaymentBalances() {
      return optionalNumber('value')
        && optionalNumber('previousBalance')
        && optionalNumber('remainingBalance')
        && request.resource.data.get('remainingBalance', 0)
          <= request.resource.data.get('previousBalance', 0);
    }

    function validClientClassification(data) {
      return !('classification' in data) || data.classification in [
        'unclassified',
        'excellent',
        'good',
        'regular',
        'poor',
        'prego',
      ];
    }

    function validTripReference(uid, data) {
      return data.tripId is string
        && data.tripId.size() <= 250
        && data.tripName is string
        && data.tripName.size() > 0
        && data.tripName.size() <= 100
        && (data.tripId.matches('^legacy-(number|name)-[a-z0-9-]+$')
          || get(/databases/$(database)/documents/users/$(uid)/trips/$(data.tripId)).data.name == data.tripName);
    }

    function validOptionalSaleTrip(uid) {
      return request.resource.data.get('tripId', '') == ''
        || validTripReference(uid, request.resource.data);
    }

    function validVisit(uid) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'clientId', 'city', 'cityKey', 'tripId', 'tripName', 'status',
          'history', 'createdAt', 'updatedAt'
        ])
        && data.clientId is string
        && data.city is string
        && data.cityKey is string
        && data.cityKey.size() > 0
        && data.cityKey.size() <= 100
        && data.city == get(/databases/$(database)/documents/users/$(uid)/clients/$(data.clientId)).data.city
        && validTripReference(uid, data)
        && data.status in ['not_purchased', 'unvisited']
        && data.history is list
        && data.history.size() > 0
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    match /users/{uid} {
      allow read, write: if false;

      match /clients/{clientId} {
        allow read: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.name is string
          && request.resource.data.city is string
          && optionalNumber('totalDebt')
          && validClientClassification(request.resource.data);
        allow update: if owner(uid)
          && unchangedOrString('name')
          && unchangedOrString('city')
          && unchangedOrNumber('totalDebt')
          && unchangedOrNumber('totalReceived')
          && validClientClassification(request.resource.data);
        allow delete: if owner(uid);
      }

      match /clients/{clientId}/payments/{paymentId} {
        allow read: if owner(uid);
        allow create: if owner(uid) && optionalPaymentBalances();
        allow update, delete: if false;
      }

      match /products/{productId} {
        allow read: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.name is string
          && optionalNumber('quantity')
          && optionalNumber('costPrice')
          && optionalNumber('salePrice');
        allow update: if owner(uid)
          && unchangedOrString('name')
          && unchangedOrInt('quantity')
          && unchangedOrNumber('costPrice')
          && unchangedOrNumber('salePrice');
        allow delete: if owner(uid);
      }

      match /sales/{saleId} {
        allow read: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.clientId is string
          && request.resource.data.items is list
          && nonNegativeNumber(request.resource.data.total)
          && nonNegativeNumber(request.resource.data.amountPaid)
          && nonNegativeNumber(request.resource.data.pendingAmount)
          && request.resource.data.pendingAmount <= request.resource.data.total
          && validOptionalSaleTrip(uid);
        allow update: if owner(uid)
          && request.resource.data.get('clientId', null) == resource.data.get('clientId', null)
          && request.resource.data.get('items', []) is list
          && unchangedOrNumber('total')
          && unchangedOrNumber('amountPaid')
          && unchangedOrNumber('pendingAmount')
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['tripId', 'tripName'])
            || validOptionalSaleTrip(uid));
        // Compras com recebimento nunca são excluídas, preservando o histórico.
        allow delete: if owner(uid)
          && resource.data.get('amountPaid', 0) == 0;
      }

      match /sales/{saleId}/payments/{paymentId} {
        allow read: if owner(uid);
        allow create: if owner(uid) && optionalPaymentBalances();
        allow update, delete: if false;
      }

      match /expenses/{expenseId} {
        allow read, create, update, delete: if owner(uid);
      }

      match /suppliers/{supplierId} {
        allow read, create, update, delete: if owner(uid);
      }

      match /payables/{payableId} {
        allow read: if owner(uid);
        allow create: if owner(uid)
          && optionalNumber('totalAmount')
          && optionalNumber('paidAmount')
          && optionalNumber('balance');
        allow update: if owner(uid)
          && unchangedOrNumber('totalAmount')
          && unchangedOrNumber('paidAmount')
          && unchangedOrNumber('balance');
        allow delete: if owner(uid);
      }

      match /payables/{payableId}/payments/{paymentId} {
        allow read: if owner(uid);
        allow create: if owner(uid) && optionalNumber('amount');
        allow update, delete: if false;
      }

      match /stockMovements/{movementId} {
        allow read: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.productId is string
          && request.resource.data.type is string
          && nonNegativeNumber(request.resource.data.quantity)
          && nonNegativeNumber(request.resource.data.previousQuantity)
          && nonNegativeNumber(request.resource.data.newQuantity);
        allow update, delete: if false;
      }

      match /trips/{tripId} {
        allow read: if owner(uid);
        allow create: if owner(uid)
          && tripId.matches('^trip-[a-f0-9-]{36}$')
          && request.resource.data.keys().hasOnly(['name', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      // Prego legado e brindes continuam somente leitura.
      match /pregoClients/{clientId} {
        allow read: if owner(uid);
        allow write: if false;
      }

      match /clientVisits/{visitId} {
        allow read: if owner(uid);
        allow create: if owner(uid) && validVisit(uid)
          && request.resource.data.createdAt == request.time;
        allow update: if owner(uid) && validVisit(uid)
          && request.resource.data.clientId == resource.data.clientId
          && request.resource.data.cityKey == resource.data.cityKey
          && request.resource.data.tripId == resource.data.tripId
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }

      match /clientGifts/{giftId} {
        allow read: if owner(uid);
        allow write: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
